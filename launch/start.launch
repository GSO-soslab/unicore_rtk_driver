<?xml version="1.0"?>

<launch>

    <arg name="robot_name" default="changeme"/>

    <node ns="$(arg robot_name)" pkg="unicore_rtk_driver" type="driver_node.py"
          name="unicore_rtk_driver" output="screen">
          
        <rosparam command="load" file="$(find unicore_rtk_driver)/config/param.yaml"/>
    </node>

    <node ns="$(arg robot_name)" pkg="nmea_navsat_driver" type="nmea_topic_driver"
          name="nmea_navsat_driver" output="screen">

        <remap from="nmea_sentence" to="unicore/nmea" />
    </node>

</launch>
